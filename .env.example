# ── Local development (.env) ─────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
# VITE_* vars are inlined into the client bundle by Vite — fine for local dev,
# NOT for public deployment (anyone can extract them from the JS bundle).

# Groq (https://console.groq.com — keys start with gsk_)
VITE_API_BASE_URL=https://api.groq.com/openai/v1
VITE_API_KEY=
VITE_API_MODEL=llama-3.3-70b-versatile

# Other OpenAI-compatible providers:
# Grok (xAI):     VITE_API_BASE_URL=https://api.x.ai/v1                   keys: xai-…
# OpenAI:         VITE_API_BASE_URL=https://api.openai.com/v1             keys: sk-…
# OpenRouter:     VITE_API_BASE_URL=https://openrouter.ai/api/v1          keys: sk-or-v1-…

# ── Production / Vercel (set in Vercel dashboard, NOT here) ──────────────────
# These are server-side env vars read by api/chat.ts — never in the bundle.
# GROQ_API_KEY=gsk_…              ← your Groq key
# GROQ_BASE_URL=https://api.groq.com/openai/v1   ← optional override
# ALLOWED_ORIGIN=https://your-app.vercel.app      ← optional CORS lock-down
